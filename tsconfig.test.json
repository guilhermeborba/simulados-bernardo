{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build",
    "mobile",
    "packages"
  ]
}
