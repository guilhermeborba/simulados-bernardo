{
  "name": "simulados-bernardo",
  "version": "1.0.0",
  "description": "Aplicação de simulados escolares para Ensino Fundamental",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:auth": "tsc -p tsconfig.test.json && node --test .test-build/tests/auth-session.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsc -p tsconfig.test.json && node tests/e2e/run-http.mjs",
    "test:browser": "node tests/e2e/run-http.mjs --browser",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:check": "npm --prefix mobile run typecheck",
    "mobile:test": "npm --prefix mobile run test",
    "mobile:test:integration": "npm --prefix mobile run test:integration"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3"
  }
}
