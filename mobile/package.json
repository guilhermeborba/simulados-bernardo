{
  "name": "giz-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/core/*.test.ts src/simulation/*.test.ts src/platform/*.test.ts src/navigation/*.test.ts config/*.test.ts",
    "export:android": "expo export --platform android --output-dir .proof/android",
    "export:ios": "expo export --platform ios --output-dir .proof/ios",
    "prebuild": "expo prebuild --no-install",
    "generate:tokens": "node ../scripts/generate-giz-mobile.mjs",
    "test:ui": "jest --config jest.config.cjs --runInBand",
    "test:integration": "node scripts/run-integration.mjs",
    "device:fixture": "node scripts/run-integration.mjs --device"
  },
  "dependencies": {
    "expo": "57.0.28",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "expo-font": "~57.0.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.1.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Giz Kids \u2014 aplicativo nativo em desenvolvimento"
}
